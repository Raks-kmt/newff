# =============================================================
# STOP CHALLENGE 4K 60FPS STUDIO — ENVIRONMENT CONFIGURATION
# =============================================================

# 1. Telegram Bot Token (REQUIRED for Telegram Bot)
# Get yours from @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. HTTP Server Port (Render.com automatically sets this to 10000)
# Default is 5050 for local PC development:
PORT=5050

# 3. Environment (production or development)
NODE_ENV=production

# 4. Optional: Custom Chrome Executable Path
# (Auto-detected on Windows and inside Render Docker container)
# CHROME_PATH=/usr/bin/google-chrome-stable

# 5. Optional: Chrome Remote Debugging Port (default 9225)
# CHROME_DEBUG_PORT=9225
